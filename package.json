{
  "name": "ancient-kingdom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "qa:fixtures": "tsx scripts/qa-fixtures.ts",
    "qa:smoke": "node scripts/playtest.cjs",
    "qa:representative": "npm run qa:fixtures && node scripts/browser-qa.cjs",
    "qa:full": "node scripts/full-playthrough.cjs",
    "release": "npm run build && python scripts/package-release.py",
    "qa:visual": "npm run qa:fixtures && node scripts/visual-qa.cjs",
    "qa:production": "node scripts/production-smoke.cjs",
    "qa:walls": "npm run qa:fixtures && node scripts/side-wall-qa.cjs --after && node scripts/wall-input-qa.cjs && node scripts/wall-qa.cjs --after"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
